<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.tomblanchard312.Nisaba</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Tavru Docs</name>
  <summary>Write and design documents; open and save Word files</summary>
  <developer id="io.github.tomblanchard312">
    <name>Tom Blanchard</name>
  </developer>
  <description>
    <p>
      Tavru Docs is a fast, open-source word processor with a familiar ribbon: styles, tables, track changes, references, mail merge, and .docx, PDF, ODT, RTF, HTML and Markdown files. It can be driven by AI agents over MCP.
    </p>
    <p>
      Tavru Docs is based on WordCraft, the open-source word processor by the ArtCraft team and community.
    </p>
  </description>
  <launchable type="desktop-id">io.github.tomblanchard312.Nisaba.desktop</launchable>
  <icon type="stock">io.github.tomblanchard312.Nisaba</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/tomblanchard312/Qanloom</url>
  <url type="bugtracker">https://github.com/tomblanchard312/Qanloom/issues</url>
  <url type="help">https://github.com/tomblanchard312/Qanloom</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <!-- Screenshots return once there is a Qanloom screenshot in this repository. -->
  <branding>
    <color type="primary" scheme_preference="light">#cfc6f2</color>
    <color type="primary" scheme_preference="dark">#3b2f7a</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types Qanloom opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>nisaba</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
