<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime: microphone access is limited to explicit local dictation and voice commands. -->
<plist version="1.0">
<dict>
  <!-- User-initiated microphone capture for local speech recognition. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
